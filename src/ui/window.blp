using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Fedora Updater";
  default-width: 960;
  default-height: 676;
  width-request: 360;
  height-request: 360;

  // Listed widest-first: libadwaita applies only the last matching breakpoint.
  Adw.Breakpoint compact_breakpoint {
    condition ("max-width: 720px")
  }

  Adw.Breakpoint narrow_breakpoint {
    condition ("max-width: 500px")
  }

  content: Adw.ToastOverlay toast {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 210;
      max-sidebar-width: 260;
      sidebar-width-fraction: 0.24;
      show-content: true;

      sidebar: Adw.NavigationPage sidebar_page {
        title: "Observatory";
        tag: "sidebar";

        child: Adw.ToolbarView {
          top-bar-style: flat;

          [top]
          Adw.HeaderBar {
            [end]
            Gtk.Button sidebar_close_btn {
              icon-name: "go-next-symbolic";
              tooltip-text: "Return to Updates";
              visible: false;
            }
          }

          content: Gtk.Box sidebar_host {
            orientation: vertical;
            hexpand: true;
            vexpand: true;
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: "Fedora Updater";
        tag: "content";

        child: Adw.ToolbarView detail_toolbar {
          top-bar-style: flat;
          bottom-bar-style: flat;

          [top]
          Adw.HeaderBar detail_header {
            show-back-button: false;

            [start]
            Gtk.ToggleButton sidebar_toggle {
              icon-name: "sidebar-show-symbolic";
              tooltip-text: "Hide Sidebar (F9)";
              active: true;
            }

            [start]
            Gtk.Button back_to_updates_btn {
              icon-name: "go-previous-symbolic";
              tooltip-text: "Back to Updates";
              visible: false;
            }

            [start]
            Gtk.Button header_refresh {
              icon-name: "view-refresh-symbolic";
              tooltip-text: "Refresh";
              visible: false;
            }

            title-widget: Adw.WindowTitle window_title {
              title: "Fedora Updater";
            };

            // pack_end prepends, so the first end child is the trailing one.
            // The menu is listed first so Stop sits before it.
            [end]
            Gtk.MenuButton header_menu {
              icon-name: "open-menu-symbolic";
              tooltip-text: "Main Menu";
              primary: true;

              menu-model: menu {
                section {
                  item ("Activity Log", "win.view-log")
                }
                section {
                  item ("About Fedora Updater", "win.about")
                }
              };
            }

            [end]
            Gtk.Button run_stop {
              label: "Stop";
              tooltip-text: "Stop this update";
              visible: false;
            }
          }

          content: Adw.BottomSheet console_sheet {
            open: false;
            can-open: false;
            can-close: true;
            reveal-bottom-bar: false;
            show-drag-handle: true;
            full-width: true;
            modal: false;

            content: Gtk.Stack detail_view_stack {
              transition-type: crossfade;
              hexpand: true;
              vexpand: true;
              hhomogeneous: true;
              vhomogeneous: true;

            Gtk.StackPage {
              name: "updates";
              child: Adw.OverlaySplitView inspector_split {
                sidebar-position: end;
                min-sidebar-width: 268;
                max-sidebar-width: 282;
                sidebar-width-fraction: 0.34;
                show-sidebar: false;
                enable-show-gesture: false;
                enable-hide-gesture: true;

                sidebar: Gtk.Box inspector_host {
                  orientation: vertical;
                  hexpand: true;
                  vexpand: true;
                };

                content: Gtk.Stack stack {
                  transition-type: crossfade;
                  hexpand: true;
                  vexpand: true;
                  hhomogeneous: true;
                  vhomogeneous: true;

                  Gtk.StackPage {
                    name: "idle";
                    child: Gtk.Box {
                      orientation: vertical;
                      vexpand: true;
                      hexpand: true;

                      Adw.StatusPage idle_page {
                        vexpand: true;
                        icon-name: "software-update-available-symbolic";
                        title: "Check for Updates";
                        description: "System packages, apps, and firmware. Nothing changes until the list is reviewed.";

                        child: Gtk.Box {
                          orientation: vertical;
                          spacing: 12;
                          halign: center;

                          Gtk.Button idle_btn {
                            label: "Check for Updates";
                            styles ["suggested-action", "pill"]
                            halign: center;
                          }

                          Gtk.Button idle_log {
                            label: "View Log";
                            action-name: "win.view-log";
                            visible: false;
                            styles ["flat"]
                            halign: center;
                          }
                        };
                      }

                      Adw.Clamp {
                        maximum-size: 680;
                        tightening-threshold: 500;
                        margin-start: 12;
                        margin-end: 12;

                        child: Gtk.Box idle_upgrade_slot {
                          orientation: vertical;
                          visible: false;
                          margin-top: 4;
                          margin-bottom: 16;
                        };
                      }
                    };
                  }

                  Gtk.StackPage {
                    name: "auth";
                    child: Adw.StatusPage auth_page {
                      vexpand: true;
                      icon-name: "dialog-password-symbolic";
                      title: "Authentication Required";
                      description: "A system dialog asks for an administrator password. The password is not stored in this window.";

                      child: Gtk.Box {
                        orientation: vertical;
                        spacing: 12;
                        halign: center;

                        Gtk.Box {
                          orientation: horizontal;
                          spacing: 8;
                          halign: center;

                          Adw.Spinner {
                            width-request: 20;
                            height-request: 20;
                            valign: center;
                          }

                          Gtk.Label {
                            label: "Waiting for authentication";
                            styles ["dimmed"]
                          }
                        }

                        Gtk.Button auth_cancel {
                          label: "Cancel";
                          styles ["flat"]
                          halign: center;
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "checking";
                    child: Adw.ToolbarView {
                      vexpand: true;
                      hexpand: true;

                      content: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        styles ["page-fill"]

                        Adw.Clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-top: 12;
                          margin-bottom: 8;

                          child: Gtk.Box {
                            orientation: vertical;
                            spacing: 6;
                            styles ["progress-block"]

                            Gtk.ProgressBar check_progress {
                              fraction: 0.05;
                              hexpand: true;
                            }

                            Gtk.Box {
                              orientation: horizontal;
                              spacing: 8;

                              Gtk.Label check_progress_meta {
                                label: "System in progress · Apps queued · Firmware queued";
                                halign: start;
                                hexpand: true;
                                ellipsize: end;
                                styles ["dimmed", "caption"]
                              }

                              Gtk.Label check_progress_pct {
                                label: "0%";
                                styles ["dimmed", "caption", "numeric"]
                              }
                            }
                          };
                        }

                        Adw.Clamp check_list_header_clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 14;
                          margin-end: 14;
                          margin-top: 4;
                          margin-bottom: 2;
                          visible: false;

                          child: Gtk.Label {
                            label: "Found so far";
                            halign: start;
                            xalign: 0;
                            styles ["heading"]
                          };
                        }

                        Gtk.ScrolledWindow check_list_scroll {
                          vexpand: true;
                          hexpand: true;
                          hscrollbar-policy: never;
                          vscrollbar-policy: automatic;
                          propagate-natural-height: false;
                          styles ["list-scroll"]

                          child: Adw.ClampScrollable check_list_clamp {
                            maximum-size: 704;
                            tightening-threshold: 500;
                          };
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "ready";
                    child: Adw.ToolbarView ready_toolbar {
                      vexpand: true;
                      hexpand: true;
                      top-bar-style: flat;
                      bottom-bar-style: raised;

                      content: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        styles ["page-fill"]

                        Adw.Banner ready_banner {
                          revealed: false;
                          button-label: "View Log";
                        }

                        Adw.Clamp ready_filter_clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-top: 10;
                          margin-bottom: 4;

                          child: Gtk.Box {
                            orientation: horizontal;
                            spacing: 8;

                            Gtk.SearchEntry ready_search {
                              placeholder-text: "Search packages…";
                              hexpand: true;
                              search-delay: 80;
                            }

                            Gtk.Label ready_filter_status {
                              label: "";
                              visible: false;
                              valign: center;
                              styles ["dimmed", "caption", "numeric"]
                            }

                            Gtk.Button ready_clear_filter {
                              label: "Clear";
                              visible: false;
                              valign: center;
                              styles ["flat"]
                            }
                          };
                        }

                        Adw.Clamp ready_selection_bar {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 14;
                          margin-end: 14;
                          margin-top: 2;
                          margin-bottom: 4;
                          visible: false;

                          child: Gtk.Box {
                            orientation: horizontal;
                            spacing: 10;

                            Gtk.CheckButton ready_select_all {
                              label: "Toggle All Selected";
                              active: true;
                              valign: center;
                              styles ["caption"]
                            }

                            Gtk.Label ready_selection_summary {
                              label: "";
                              xalign: 1;
                              halign: end;
                              hexpand: true;
                              valign: center;
                              styles ["dimmed", "caption", "numeric"]
                            }
                          };
                        }

                        Gtk.Stack ready_list_stack {
                          vexpand: true;
                          hexpand: true;
                          transition-type: crossfade;

                          Gtk.StackPage {
                            name: "list";
                            child: Gtk.ScrolledWindow {
                              vexpand: true;
                              hexpand: true;
                              hscrollbar-policy: never;
                              vscrollbar-policy: automatic;
                              propagate-natural-height: false;
                              styles ["list-scroll"]

                              child: Adw.ClampScrollable ready_list_clamp {
                                maximum-size: 704;
                                tightening-threshold: 500;
                              };
                            };
                          }

                          Gtk.StackPage {
                            name: "empty-filter";
                            child: Adw.Clamp {
                              maximum-size: 680;
                              tightening-threshold: 500;
                              margin-start: 12;
                              margin-end: 12;
                              margin-top: 12;
                              valign: start;

                              child: Gtk.Box {
                                orientation: vertical;
                                styles ["card"]

                                Gtk.Box {
                                  orientation: vertical;
                                  spacing: 10;
                                  margin-top: 24;
                                  margin-bottom: 24;
                                  margin-start: 20;
                                  margin-end: 20;
                                  halign: center;

                                  Gtk.Label {
                                    label: "No matching packages";
                                    styles ["heading"]
                                  }

                                  Gtk.Label {
                                    label: "Adjust the source filter or search query to see available updates.";
                                    wrap: true;
                                    justify: center;
                                    styles ["dimmed", "caption"]
                                  }

                                  Gtk.Button ready_empty_clear_btn {
                                    label: "Clear Filters";
                                    halign: center;
                                  }
                                }
                              };
                            };
                          }
                        }

                        Adw.Clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          margin-start: 12;
                          margin-end: 12;

                          child: Gtk.Box ready_upgrade_slot {
                            orientation: vertical;
                            visible: false;
                            margin-top: 4;
                            margin-bottom: 10;
                          };
                        }
                      };

                      [bottom]
                      Adw.Clamp {
                        maximum-size: 680;
                        tightening-threshold: 500;
                        hexpand: true;
                        margin-start: 12;
                        margin-end: 12;

                        child: Gtk.Box {
                          orientation: horizontal;
                          spacing: 12;
                          margin-top: 10;
                          margin-bottom: 10;

                          Gtk.Label {
                            label: "Nothing is applied until Update All is chosen";
                            halign: start;
                            xalign: 0;
                            hexpand: true;
                            valign: center;
                            wrap: true;
                            styles ["dimmed", "caption"]
                          }

                          Gtk.Button ready_update {
                            label: "Update All";
                            valign: center;
                            styles ["suggested-action"]
                          }

                          Adw.SplitButton ready_split_update {
                            label: "Update All";
                            visible: false;
                            valign: center;
                            styles ["suggested-action"]

                            menu-model: menu {
                              section {
                                item {
                                  label: "Update All";
                                  action: "win.apply-mode";
                                  target: "live";
                                }
                                item {
                                  label: "Update & Restart";
                                  action: "win.apply-mode";
                                  target: "live-reboot";
                                }
                                item {
                                  label: "Prepare Offline Update";
                                  action: "win.apply-mode";
                                  target: "offline";
                                }
                                item {
                                  label: "Download Only";
                                  action: "win.apply-mode";
                                  target: "download-only";
                                }
                              }
                            };
                          }
                        };
                      }
                    };
                  }

                  Gtk.StackPage {
                    name: "running";
                    child: Adw.ToolbarView {
                      vexpand: true;
                      hexpand: true;

                      content: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        styles ["page-fill"]

                        Adw.Clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-top: 12;
                          margin-bottom: 8;

                          child: Gtk.Box {
                            orientation: vertical;
                            styles ["card"]

                            Gtk.Box {
                              orientation: vertical;
                              spacing: 8;
                              margin-top: 14;
                              margin-bottom: 14;
                              margin-start: 16;
                              margin-end: 16;

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 8;

                                Adw.WrapBox {
                                  hexpand: true;
                                  child-spacing: 6;
                                  line-spacing: 6;

                                  Gtk.Label stage_download {
                                    label: "Download";
                                    styles ["stage-crumb"]
                                  }

                                  Gtk.Label stage_prepare {
                                    label: "Prepare";
                                    styles ["stage-crumb"]
                                  }

                                  Gtk.Label stage_install {
                                    label: "Install";
                                    styles ["stage-crumb"]
                                  }

                                  Gtk.Label stage_verify {
                                    label: "Verify";
                                    styles ["stage-crumb"]
                                  }
                                }

                                Gtk.Label run_progress_pct {
                                  label: "0%";
                                  valign: center;
                                  styles ["heading", "numeric"]
                                }
                              }

                              Gtk.ProgressBar run_progress {
                                fraction: 0.0;
                                hexpand: true;
                              }

                              Gtk.Label run_progress_meta {
                                label: "Starting…";
                                halign: start;
                                xalign: 0;
                                ellipsize: end;
                                styles ["dimmed", "caption", "numeric"]
                              }
                            }
                          };
                        }

                        Adw.Banner run_stall {
                          revealed: false;
                          button-label: "View Log";
                        }

                        Adw.Clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-bottom: 10;

                          child: Gtk.Box current_package {
                            orientation: vertical;
                            hexpand: true;
                            styles ["card"]

                            Gtk.Box {
                              orientation: horizontal;
                              spacing: 14;
                              margin-top: 16;
                              margin-bottom: 16;
                              margin-start: 18;
                              margin-end: 18;

                              Gtk.Box now_playing_ring_slot {
                                valign: center;
                              }

                              Gtk.Box {
                                orientation: vertical;
                                spacing: 3;
                                hexpand: true;
                                valign: center;

                                Gtk.Box {
                                  orientation: horizontal;
                                  spacing: 8;
                                  valign: center;

                                  Gtk.Label now_playing_badge {
                                    visible: false;
                                    valign: center;
                                    halign: center;
                                  }

                                  Gtk.Label now_playing_title {
                                    label: "Starting…";
                                    halign: start;
                                    hexpand: true;
                                    ellipsize: end;
                                    xalign: 0;
                                    styles ["heading"]
                                  }
                                }

                                Gtk.Label now_playing_subtitle {
                                  label: "";
                                  halign: start;
                                  ellipsize: end;
                                  xalign: 0;
                                  styles ["dimmed", "caption"]
                                }
                              }

                              Gtk.Label now_playing_size {
                                label: "";
                                valign: center;
                                visible: false;
                                styles ["dimmed", "caption", "numeric"]
                              }

                              Gtk.Stack now_playing_status_stack {
                                width-request: 22;
                                height-request: 22;
                                valign: center;
                                halign: center;
                                transition-type: crossfade;
                                transition-duration: 150;
                                hhomogeneous: true;
                                vhomogeneous: true;

                                Gtk.StackPage {
                                  name: "spinner";
                                  child: Adw.Spinner now_playing_spinner {
                                    width-request: 18;
                                    height-request: 18;
                                    valign: center;
                                    halign: center;
                                  };
                                }

                                Gtk.StackPage {
                                  name: "status";
                                  child: Gtk.Image now_playing_status_icon {
                                    icon-name: "software-update-available-symbolic";
                                    pixel-size: 16;
                                    valign: center;
                                    halign: center;
                                  };
                                }
                              }
                            }
                          };
                        }

                        Gtk.ScrolledWindow run_list_scroll {
                          vexpand: true;
                          hexpand: true;
                          hscrollbar-policy: never;
                          vscrollbar-policy: automatic;
                          propagate-natural-height: false;
                          styles ["list-scroll"]

                          child: Adw.Clamp {
                            maximum-size: 680;
                            tightening-threshold: 500;
                            hexpand: true;
                            margin-start: 12;
                            margin-end: 12;

                            child: Gtk.Box {
                              orientation: vertical;
                              spacing: 12;
                              margin-top: 2;
                              margin-bottom: 14;

                              Gtk.Box run_list_slot {
                                orientation: vertical;
                              }

                              Adw.PreferencesGroup run_completed_group {
                                Adw.ExpanderRow run_completed {
                                  title: "0 completed";
                                  expanded: false;
                                  enable-expansion: true;
                                }
                              }
                            };
                          };
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "done";
                    child: Adw.ToolbarView done_toolbar {
                      vexpand: true;
                      hexpand: true;
                      top-bar-style: flat;
                      bottom-bar-style: raised;

                      content: Gtk.Box {
                        orientation: vertical;
                        vexpand: true;
                        hexpand: true;
                        styles ["page-fill"]

                        Adw.Banner done_problem_banner {
                          revealed: false;
                          button-label: "View Log";
                        }

                        Adw.Clamp done_summary_clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-top: 12;
                          visible: false;

                          child: Gtk.Box {
                            orientation: vertical;
                            styles ["card", "done-summary-card"]

                            Gtk.Box {
                              orientation: horizontal;
                              spacing: 12;
                              margin-top: 14;
                              margin-bottom: 14;
                              margin-start: 18;
                              margin-end: 18;

                              Gtk.Image {
                                icon-name: "object-select-symbolic";
                                pixel-size: 20;
                                valign: center;
                                styles ["success"]
                              }

                              Gtk.Box {
                                orientation: vertical;
                                spacing: 2;
                                hexpand: true;
                                valign: center;

                                Gtk.Label {
                                  label: "All updates applied";
                                  halign: start;
                                  xalign: 0;
                                  styles ["heading"]
                                }

                                Gtk.Label done_summary_detail {
                                  label: "";
                                  halign: start;
                                  xalign: 0;
                                  wrap: true;
                                  styles ["dimmed", "caption", "numeric"]
                                }
                              }
                            }
                          };
                        }

                        Adw.Clamp done_reboot_clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 12;
                          margin-end: 12;
                          margin-top: 12;
                          visible: false;

                          child: Gtk.Box {
                            orientation: vertical;
                            styles ["card", "reboot-card"]

                            Gtk.Box {
                              orientation: horizontal;
                              spacing: 12;
                              margin-top: 14;
                              margin-bottom: 14;
                              margin-start: 18;
                              margin-end: 18;

                              Gtk.Image {
                                icon-name: "system-reboot-symbolic";
                                pixel-size: 20;
                                valign: center;
                                styles ["warning"]
                              }

                              Gtk.Box {
                                orientation: vertical;
                                spacing: 2;
                                hexpand: true;
                                valign: center;

                                Gtk.Label done_reboot_title {
                                  label: "Restart Recommended";
                                  halign: start;
                                  xalign: 0;
                                  styles ["heading"]
                                }

                                Gtk.Label done_reboot_detail {
                                  label: "";
                                  halign: start;
                                  xalign: 0;
                                  wrap: true;
                                  styles ["dimmed", "caption"]
                                }
                              }

                              Gtk.Button done_reboot_btn {
                                label: "Restart Now";
                                valign: center;
                                styles ["suggested-action"]
                              }
                            }
                          };
                        }

                        Adw.Clamp done_installed_header_clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          hexpand: true;
                          margin-start: 14;
                          margin-end: 14;
                          margin-top: 12;
                          margin-bottom: 2;

                          child: Gtk.Label done_installed_heading {
                            label: "Installed";
                            halign: start;
                            xalign: 0;
                            styles ["heading"]
                          };
                        }

                        Gtk.ScrolledWindow done_installed_scroll {
                          vexpand: true;
                          hexpand: true;
                          hscrollbar-policy: never;
                          vscrollbar-policy: automatic;
                          propagate-natural-height: false;
                          styles ["list-scroll"]

                          child: Adw.ClampScrollable done_list_clamp {
                            maximum-size: 704;
                            tightening-threshold: 500;
                          };
                        }

                        Adw.Clamp {
                          maximum-size: 680;
                          tightening-threshold: 500;
                          margin-start: 12;
                          margin-end: 12;

                          child: Gtk.Box done_upgrade_slot {
                            orientation: vertical;
                            visible: false;
                            margin-top: 4;
                            margin-bottom: 10;
                          };
                        }
                      };

                      [bottom]
                      Adw.Clamp {
                        maximum-size: 680;
                        tightening-threshold: 500;
                        hexpand: true;
                        margin-start: 12;
                        margin-end: 12;

                        child: Gtk.Box {
                          orientation: horizontal;
                          spacing: 8;
                          halign: end;
                          margin-top: 10;
                          margin-bottom: 10;

                          Gtk.Button done_log_btn {
                            label: "View Full Log";
                            action-name: "win.view-log";
                            styles ["flat"]
                          }

                          Gtk.Button done_retry_btn {
                            label: "Check Again";
                            visible: false;
                          }

                          Gtk.Button done_btn {
                            label: "Done";
                          }
                        };
                      }
                    };
                  }

                  Gtk.StackPage {
                    name: "failed";
                    child: Adw.StatusPage fail_page {
                      vexpand: true;
                      icon-name: "dialog-error-symbolic";
                      title: "Update failed";

                      child: Gtk.Box {
                        orientation: vertical;
                        spacing: 12;
                        halign: center;

                        Gtk.Button fail_retry {
                          label: "Check Again";
                          styles ["suggested-action", "pill"]
                          halign: center;
                        }

                        Gtk.Button fail_log {
                          label: "View Log";
                          action-name: "win.view-log";
                          styles ["flat"]
                          halign: center;
                        }
                      };
                    };
                  }
                };
              };
            }

            Gtk.StackPage {
              name: "activity-log";
              child: Gtk.Box activity_log_host {
                orientation: vertical;
                hexpand: true;
                vexpand: true;
              };
            }

            Gtk.StackPage {
              name: "history";
              child: Gtk.Box history_host {
                orientation: vertical;
                hexpand: true;
                vexpand: true;
              };
            }
            };

            bottom-bar: Gtk.Box {
              orientation: vertical;
              styles ["console-bar"]

              Gtk.Button console_toggle {
                styles ["flat"]
                hexpand: true;
                tooltip-text: "Toggle live output console";

                child: Gtk.Box {
                  orientation: horizontal;
                  spacing: 8;

                  Gtk.Image console_chevron {
                    icon-name: "pan-end-symbolic";
                  }

                  Gtk.Label console_line {
                    label: "Starting…";
                    hexpand: true;
                    halign: start;
                    ellipsize: end;
                    styles ["monospace", "caption", "dimmed"]
                  }

                  Gtk.Label {
                    label: "Console";
                    valign: center;
                    styles ["caption", "accent"]
                  }
                };
              }
            };

            sheet: Gtk.Box {
              orientation: vertical;
              height-request: 220;
              styles ["console-sheet"]

              Gtk.Box {
                orientation: horizontal;
                spacing: 8;
                margin-top: 8;
                margin-bottom: 8;
                margin-start: 14;
                margin-end: 10;

                Gtk.Label {
                  label: "Live Output";
                  hexpand: true;
                  halign: start;
                  xalign: 0;
                  styles ["heading"]
                }

                Gtk.Button console_copy_btn {
                  label: "Copy";
                  styles ["flat"]
                  valign: center;
                }

                Gtk.Button console_close_btn {
                  icon-name: "window-close-symbolic";
                  styles ["flat"]
                  valign: center;
                  tooltip-text: "Close console (Esc)";
                }
              }

              Gtk.ScrolledWindow {
                vexpand: true;
                hexpand: true;
                min-content-height: 160;
                max-content-height: 280;
                propagate-natural-height: false;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;

                child: Gtk.TextView console_full {
                  editable: false;
                  cursor-visible: false;
                  monospace: true;
                  wrap-mode: word_char;
                  left-margin: 14;
                  right-margin: 14;
                  top-margin: 10;
                  bottom-margin: 12;
                  styles ["activity-log-view", "caption"]
                };
              }
            };
          };
        };
      };
    };
  };
}
