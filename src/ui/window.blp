using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Fedora Updater";
  default-width: 760;
  default-height: 660;

  Adw.Breakpoint narrow_breakpoint {
    condition ("max-width: 500px")
  }

  content: Adw.ToastOverlay toast {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [start]
        Gtk.Button header_refresh {
          icon-name: "view-refresh-symbolic";
          tooltip-text: "Refresh";
          visible: false;
        }

        title-widget: Adw.WindowTitle window_title {
          title: "Fedora Updater";
        };

        // pack_end prepends, so the first end child is the trailing one.
        // The menu is listed first so Stop sits before it.
        [end]
        Gtk.MenuButton header_menu {
          icon-name: "open-menu-symbolic";
          tooltip-text: "Main Menu";
          primary: true;

          menu-model: menu {
            section {
              item ("About Fedora Updater", "win.about")
            }
          };
        }

        [end]
        Gtk.Button run_stop {
          label: "Stop";
          tooltip-text: "Stop this update";
          visible: false;
        }
      }

      content: Gtk.Stack stack {
        transition-type: crossfade;
        hexpand: true;
        vexpand: true;
        hhomogeneous: true;
        vhomogeneous: true;

        Gtk.StackPage {
          name: "idle";
          child: Adw.StatusPage idle_page {
            vexpand: true;
            icon-name: "software-update-available-symbolic";
            title: "Check for Updates";
            description: "System packages, apps, and firmware. Nothing changes until the list is reviewed.";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Button idle_btn {
                label: "Check for Updates";
                styles ["suggested-action", "pill"]
                halign: center;
              }
            };
          };
        }

        Gtk.StackPage {
          name: "auth";
          child: Adw.StatusPage auth_page {
            vexpand: true;
            icon-name: "dialog-password-symbolic";
            title: "Authentication Required";
            description: "A system dialog asks for an administrator password. The password is not stored in this window.";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Box {
                orientation: horizontal;
                spacing: 8;
                halign: center;

                Adw.Spinner {
                  width-request: 20;
                  height-request: 20;
                  valign: center;
                }

                Gtk.Label {
                  label: "Waiting for authentication";
                  styles ["dimmed"]
                }
              }

              Gtk.Button auth_cancel {
                label: "Cancel";
                styles ["flat"]
                halign: center;
              }
            };
          };
        }

        Gtk.StackPage {
          name: "checking";
          child: Adw.ToolbarView {
            vexpand: true;
            hexpand: true;

            content: Gtk.Box {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
              styles ["page-fill"]

              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                styles ["progress-block"]

                Gtk.ProgressBar check_progress {
                  fraction: 0.05;
                  hexpand: true;
                }

                Gtk.Box {
                  orientation: horizontal;
                  spacing: 8;

                  Gtk.Label check_progress_meta {
                    label: "System in progress · Apps queued · Firmware queued";
                    halign: start;
                    hexpand: true;
                    ellipsize: end;
                    styles ["dimmed", "caption"]
                  }

                  Gtk.Label check_progress_pct {
                    label: "0%";
                    styles ["dimmed", "caption", "numeric"]
                  }
                }
              }

              Gtk.ScrolledWindow check_list_scroll {
                vexpand: true;
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: false;
                styles ["list-scroll"]

                child: Adw.Clamp {
                  maximum-size: 700;
                  tightening-threshold: 500;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 8;

                  child: Adw.PreferencesGroup check_group {
                    title: "Found so far";
                  };
                };
              }

              Gtk.Revealer check_console_reveal {
                transition-type: slide_up;
                reveal-child: false;

                child: Gtk.ScrolledWindow {
                  max-content-height: 160;
                  propagate-natural-height: true;

                  child: Gtk.Label check_console_full {
                    label: "";
                    wrap: true;
                    selectable: true;
                    halign: start;
                    xalign: 0;
                    styles ["monospace", "caption"]
                  };
                };
              }
            };

            [bottom]
            Gtk.Box {
              orientation: vertical;
              styles ["console-bar"]

              Gtk.Button check_console_toggle {
                styles ["flat"]
                hexpand: true;

                child: Gtk.Box {
                  orientation: horizontal;
                  spacing: 8;

                  Gtk.Image check_console_chevron {
                    icon-name: "pan-end-symbolic";
                  }

                  Gtk.Label check_console_line {
                    label: "Starting…";
                    hexpand: true;
                    halign: start;
                    ellipsize: end;
                    styles ["monospace", "caption", "dimmed"]
                  }
                };
              }
            }
          };
        }

        Gtk.StackPage {
          name: "ready";
          child: Adw.ToolbarView {
            vexpand: true;
            hexpand: true;

            content: Gtk.Box {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
              styles ["page-fill"]

              Adw.Banner ready_banner {
                revealed: false;
                button-label: "View Log";
              }

              Gtk.ScrolledWindow {
                vexpand: true;
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: false;
                styles ["list-scroll"]

                child: Adw.Clamp {
                  maximum-size: 700;
                  tightening-threshold: 500;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 8;

                  child: Adw.PreferencesGroup ready_group {};
                };
              }

              Gtk.Label {
                label: "Nothing is applied until Update All is chosen";
                halign: start;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 10;
                styles ["dimmed", "caption"]
              }
            };

            [bottom]
            Gtk.Box {
              orientation: horizontal;
              halign: end;
              margin-start: 12;
              margin-end: 12;
              margin-top: 8;
              margin-bottom: 8;

              Gtk.Button ready_update {
                label: "Update All";
                styles ["suggested-action"]
              }
            }
          };
        }

        Gtk.StackPage {
          name: "running";
          child: Adw.ToolbarView {
            vexpand: true;
            hexpand: true;

            content: Gtk.Box {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
              styles ["page-fill"]

              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                styles ["progress-block"]

                Gtk.ProgressBar run_progress {
                  fraction: 0.0;
                  hexpand: true;
                }

                Gtk.Box {
                  orientation: horizontal;
                  spacing: 8;

                  Gtk.Label run_progress_meta {
                    label: "Starting…";
                    halign: start;
                    hexpand: true;
                    ellipsize: end;
                    styles ["dimmed", "caption"]
                  }

                  Gtk.Label run_progress_pct {
                    label: "0%";
                    styles ["dimmed", "caption", "numeric"]
                  }
                }
              }

              Adw.Banner run_stall {
                revealed: false;
              }

              Adw.Clamp {
                maximum-size: 700;
                tightening-threshold: 500;
                hexpand: true;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 8;

                child: Gtk.Box current_package {
                  orientation: vertical;
                  spacing: 8;
                  hexpand: true;
                  styles ["card"]

                  Gtk.Box {
                    orientation: horizontal;
                    spacing: 10;

                    Gtk.Label now_playing_badge {
                      visible: false;
                      valign: center;
                      halign: center;
                    }

                    Adw.Spinner now_playing_spinner {
                      width-request: 18;
                      height-request: 18;
                      valign: center;
                      halign: center;
                    }

                    Gtk.Box {
                      orientation: vertical;
                      spacing: 2;
                      hexpand: true;
                      valign: center;

                      Gtk.Label now_playing_title {
                        label: "Starting…";
                        halign: start;
                        ellipsize: end;
                        xalign: 0;
                        styles ["heading"]
                      }

                      Gtk.Label now_playing_subtitle {
                        label: "";
                        halign: start;
                        ellipsize: end;
                        xalign: 0;
                        styles ["dimmed", "caption"]
                      }
                    }

                    Gtk.Label now_playing_size {
                      label: "";
                      valign: center;
                      visible: false;
                      styles ["dimmed", "caption"]
                    }

                    Gtk.Label now_playing_pct {
                      label: "";
                      valign: center;
                      width-chars: 4;
                      styles ["numeric", "caption", "dimmed"]
                    }
                  }
                };
              }

              Gtk.ScrolledWindow run_list_scroll {
                vexpand: true;
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: false;
                styles ["list-scroll"]

                child: Adw.Clamp {
                  maximum-size: 700;
                  tightening-threshold: 500;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 8;

                  child: Adw.PreferencesGroup run_list_group {
                  };
                };
              }

              Adw.Clamp {
                maximum-size: 700;
                tightening-threshold: 500;
                hexpand: true;
                margin-start: 12;
                margin-end: 12;
                margin-bottom: 8;

                child: Adw.PreferencesGroup run_completed_group {
                  Adw.ExpanderRow run_completed {
                    title: "0 completed";
                    expanded: false;
                    enable-expansion: true;
                  }
                };
              }

              Gtk.Revealer run_console_reveal {
                transition-type: slide_up;
                reveal-child: false;

                child: Gtk.ScrolledWindow {
                  max-content-height: 160;
                  propagate-natural-height: true;

                  child: Gtk.Label run_console_full {
                    label: "";
                    wrap: true;
                    selectable: true;
                    halign: start;
                    xalign: 0;
                    styles ["monospace", "caption"]
                  };
                };
              }
            };

            [bottom]
            Gtk.Box {
              orientation: vertical;
              styles ["console-bar"]

              Gtk.Button run_console_toggle {
                styles ["flat"]
                hexpand: true;

                child: Gtk.Box {
                  orientation: horizontal;
                  spacing: 8;

                  Gtk.Image run_console_chevron {
                    icon-name: "pan-end-symbolic";
                  }

                  Gtk.Label run_console_line {
                    label: "";
                    hexpand: true;
                    halign: start;
                    ellipsize: end;
                    styles ["monospace", "caption", "dimmed"]
                  }
                };
              }
            }
          };
        }

        Gtk.StackPage {
          name: "done";
          child: Adw.ToolbarView {
            vexpand: true;
            hexpand: true;

            content: Gtk.Box {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
              styles ["page-fill"]

              Adw.Banner reboot_banner {
                title: "Restart recommended to finish installing";
                button-label: "Restart Now";
                revealed: false;
              }

              Gtk.ScrolledWindow done_installed_scroll {
                vexpand: true;
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: false;
                styles ["list-scroll"]

                child: Adw.Clamp {
                  maximum-size: 700;
                  tightening-threshold: 500;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 8;

                  child: Adw.PreferencesGroup done_installed {
                    title: "Installed";
                  };
                };
              }
            };

            [bottom]
            Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              halign: end;
              margin-start: 12;
              margin-end: 12;
              margin-top: 8;
              margin-bottom: 8;

              Gtk.Button done_log_btn {
                label: "View Full Log";
                styles ["flat"]
              }

              Gtk.Button done_btn {
                label: "Done";
              }
            }
          };
        }

        Gtk.StackPage {
          name: "failed";
          child: Adw.StatusPage fail_page {
            vexpand: true;
            icon-name: "dialog-error-symbolic";
            title: "Update failed";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Button fail_retry {
                label: "Check Again";
                styles ["suggested-action", "pill"]
                halign: center;
              }

              Gtk.Button fail_log {
                label: "View Log";
                styles ["flat"]
                halign: center;
              }
            };
          };
        }
      };
    };
  };
}
